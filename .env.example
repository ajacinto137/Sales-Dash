# ============================================================
# PLANETWEB / MICROSOFT SQL SERVER
# ============================================================

PLANETWEB_HOST=sql1.planetweb.planet.net
PLANETWEB_DATABASE=PlanetWeb

# >>> ENTER SQL SERVER USERNAME HERE <<<
PLANETWEB_USERNAME=

# >>> ENTER SQL SERVER PASSWORD HERE <<<
PLANETWEB_PASSWORD=


# ============================================================
# KPI REPORTING / POSTGRESQL
# ============================================================

KPI_HOST=api2.planetweb.planet.net
KPI_PORT=5432
KPI_DATABASE=kpi_reporting

# >>> ENTER POSTGRESQL USERNAME HERE <<<
KPI_USERNAME=

# >>> ENTER POSTGRESQL PASSWORD HERE <<<
KPI_PASSWORD=


# ============================================================
# APPLICATION DATABASE (app-owned, NOT a source database)
# Backs the Needs Attention workflow (Attention Status + notes) --
# see README.md "Needs Attention Workflow". Its own Postgres
# container (docker-compose.yml's "appdb" service), separate from
# PlanetWeb/KPI, both of which stay strictly read-only. Any values
# work here -- this stands up a fresh local database rather than
# connecting to an existing one, so there's nothing to "get right"
# beyond picking a password.
# ============================================================

APPDB_HOST=appdb
APPDB_PORT=5432
APPDB_DATABASE=sales_dash_app
APPDB_USERNAME=sales_dash_app

# >>> ENTER ANY PASSWORD HERE (this creates a new local database) <<<
APPDB_PASSWORD=


# ============================================================
# APPLICATION
# ============================================================

APP_PORT=3005
FLASK_DEBUG=true


# ============================================================
# PRODUCTION ONLY (docker-compose.prod.yml — nginx + SSL)
# Not used by local dev (docker-compose.yml).
# ============================================================

# Domain the dashboard is served from. Used for the nginx
# server_name.
DOMAIN=

# Host directory containing your SSL certificate. Must contain
# fullchain.pem and privkey.pem. Mounted read-only into the
# nginx container. Can point anywhere on the host (defaults to
# ./certs, gitignored).
SSL_CERTS_DIR=./certs
