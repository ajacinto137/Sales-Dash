# ============================================================
# PLANETWEB / MICROSOFT SQL SERVER
# ============================================================

PLANETWEB_HOST=sql1.planetweb.planet.net
PLANETWEB_DATABASE=PlanetWeb

# >>> ENTER SQL SERVER USERNAME HERE <<<
PLANETWEB_USERNAME=

# >>> ENTER SQL SERVER PASSWORD HERE <<<
PLANETWEB_PASSWORD=


# ============================================================
# KPI REPORTING / POSTGRESQL
# ============================================================

KPI_HOST=api2.planetweb.planet.net
KPI_PORT=5432
KPI_DATABASE=kpi_reporting

# >>> ENTER POSTGRESQL USERNAME HERE <<<
KPI_USERNAME=

# >>> ENTER POSTGRESQL PASSWORD HERE <<<
KPI_PASSWORD=


# ============================================================
# APPLICATION DATABASE (app-owned, NOT a source database)
# Backs the Needs Attention workflow (Attention Status + notes) --
# see README.md "Needs Attention Workflow". Its own Postgres
# container (docker-compose.yml's "appdb" service), separate from
# PlanetWeb/KPI, both of which stay strictly read-only. Any values
# work here -- this stands up a fresh local database rather than
# connecting to an existing one, so there's nothing to "get right"
# beyond picking a password.
# ============================================================

APPDB_HOST=appdb
APPDB_PORT=5432
APPDB_DATABASE=sales_dash_app
APPDB_USERNAME=sales_dash_app

# >>> ENTER ANY PASSWORD HERE (this creates a new local database) <<<
APPDB_PASSWORD=


# ============================================================
# AUTHENTICATION (added 2026-08-18)
# See README.md "Authentication".
# ============================================================

# Signs the login session cookie. Required -- the app refuses to start
# without it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# >>> ENTER A GENERATED SECRET KEY HERE <<<
SECRET_KEY=

# The very first Admin account is auto-created under this email the
# first time the app runs (no manual database work) -- see README.md
# "First-Time Admin Setup". Change only if avelino@planet.net shouldn't
# be the initial Admin for this deployment.
INITIAL_ADMIN_EMAIL=avelino@planet.net

# Used to build absolute links in emails (e.g. https://sales.planet.net/setup/<token>).
# Defaults to the local dev URL if unset.
APP_BASE_URL=http://localhost:3005


# ============================================================
# EMAIL / SMTP (added 2026-08-18)
# Powers first-time setup / resend-setup / password-reset emails
# (email_service.py) -- see README.md "Email Configuration". Optional:
# if SMTP_HOST is left blank, emails aren't sent, and the setup/reset
# link is printed to the container logs instead (`docker compose logs`)
# so you're never blocked getting into your own dashboard before this
# is configured.
# ============================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@planet.net
SMTP_USE_TLS=true


# ============================================================
# APPLICATION
# ============================================================

APP_PORT=3005
FLASK_DEBUG=true


# ============================================================
# PRODUCTION ONLY (docker-compose.prod.yml — nginx + SSL)
# Not used by local dev (docker-compose.yml).
# ============================================================

# Domain the dashboard is served from. Used for the nginx
# server_name.
DOMAIN=

# Host directory containing your SSL certificate. Must contain
# fullchain.pem and privkey.pem. Mounted read-only into the
# nginx container. Can point anywhere on the host (defaults to
# ./certs, gitignored).
SSL_CERTS_DIR=./certs
